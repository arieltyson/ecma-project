{
  "name": "ecma-project",
  "version": "1.0.0",
  "description": "A project-driven curriculum for modern JavaScript, TypeScript, React and the browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run snippets && npm run build && npm test",
    "snippets": "node scripts/check-snippets.ts",
    "exercise": "node scripts/exercise.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@apollo/client": "4.3.2",
    "@babel/core": "8.0.6",
    "@rolldown/plugin-babel": "0.2.4",
    "@shikijs/rehype": "4.5.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "graphql": "16.14.2",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "rxjs": "7.8.2",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
